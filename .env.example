# Copy to .env. Applications load this file; Docker Compose also reads it.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rounding_app
DB_USER=rounding_app
DB_PASSWORD=replace-with-your-application-password
DB_POOL_SIZE=10
MYSQL_ROOT_PASSWORD=replace-with-your-local-root-password

# Demo authentication only; it does NOT create schema, hospitals, or patient data.
DEMO_MODE=true
BILLING_TOKEN=demo-billing-secret
PATIENT_SERVICE_TOKEN=demo-patient-service-secret
BILLING_SERVICE_TOKEN=demo-billing-service-secret
HOST=127.0.0.1
BILLING_URL=http://127.0.0.1:4001/api/v1
PATIENT_SERVICE_URL=http://127.0.0.1:3101
CHARGE_SERVICE_URL=http://127.0.0.1:3102
BILLING_SERVICE_URL=http://127.0.0.1:3103

# For non-demo authentication set DEMO_MODE=false and supply AUTH_TOKENS JSON.
# For database tests use a separate database ending in _test:
# MYSQL_TEST_URL=mysql://root:password@127.0.0.1:3306/rounding_app_test
