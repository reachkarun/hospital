# Values here are examples; the app does not automatically load this file.
# npm run demo:start enables demo mode in its child processes.
DEMO_MODE=true
# Each service defaults to its own data/<service>.db; set DATABASE_PATH only for an individual process.
BILLING_URL=http://127.0.0.1:4001/api/v1
BILLING_TOKEN=demo-billing-secret
# Set PORT only for an individual process; gateway defaults to 3002.
API_HOST_PORT=3002
HOST=127.0.0.1
