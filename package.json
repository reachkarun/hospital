{
  "name": "rounding-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "demo:start": "tsx scripts/start-demo.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "worker": "tsx src/worker-main.ts",
    "mock": "tsx src/mock-main.ts",
    "demo": "tsx scripts/demo.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.0",
    "@fastify/swagger-ui": "6.1.1",
    "fastify": "5.12.5",
    "zod": "3.25.76",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
